{
	"name": "@hoard-engine/i18n",
	"version": "0.1.0",
	"description": "Framework-independent translations with Svelte-compatible stores",
	"keywords": ["i18n", "translations", "localization", "game"],
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": ["dist"],
	"sideEffects": false,
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepare": "npm run build",
		"test": "vitest run",
		"check": "tsc --noEmit",
		"prepublishOnly": "npm run check && npm run build && npm test"
	},
	"publishConfig": {
		"access": "public"
	},
	"devDependencies": {
		"@types/node": "^22.20.5",
		"typescript": "^6.0.3",
		"vitest": "^5.1.0"
	}
}